
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="dark" />
<title>Digital+ · The future of work in Africa</title>
<meta name="description" content="Digital+ connects verified employers with Africa's best talent. Success-based pricing. No cost to candidates." />
<style>
:root{
  --navy:#000B1F;--navy2:#0A1F44;--blue:#00B4FF;--cyan:#22D3EE;
  --white:#fff;--muted:#B8C5D6;--subtle:#7B8CA6;--dim:#4A5C7A;
  --border:rgba(0,180,255,.20);--border-soft:rgba(0,180,255,.10);
  --danger:#f87171;--success:#22c55e;
  --font:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
}
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;padding:0;scroll-behavior:smooth}
body{font-family:var(--font);font-size:16px;line-height:1.6;
  color:var(--white);background:var(--navy);overflow-x:hidden;
  -webkit-font-smoothing:antialiased}
h1,h2,h3{margin:0;line-height:1.15;font-weight:800;letter-spacing:-.02em}
p{margin:0}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit;color:inherit}
ul{margin:0;padding:0;list-style:none}
.hidden{display:none!important}

body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(ellipse 80% 50% at 50% 0%, rgba(0,150,255,.18), transparent 70%),
    radial-gradient(ellipse 60% 40% at 20% 80%, rgba(0,180,255,.08), transparent 70%);
}

.wrap{position:relative;z-index:2;max-width:1200px;margin:0 auto;padding:0 20px}
@media(min-width:700px){.wrap{padding:0 32px}}

header{position:sticky;top:0;z-index:50;padding:16px 0;
  background:rgba(0,11,31,.75);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border-soft)}
.hrow{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{display:flex;align-items:center;gap:12px}
.logo svg{width:44px;height:44px;filter:drop-shadow(0 0 14px rgba(0,180,255,.5))}
.lname{display:flex;flex-direction:column;line-height:1}
.ltitle{font-size:24px;font-weight:800;letter-spacing:-.03em;display:flex;align-items:center}
.ltitle .plus{color:var(--blue);font-size:26px;font-weight:900;margin-left:1px}
.ltag{font-size:11px;color:var(--muted);margin-top:5px}
.ltag .acc{color:var(--blue);font-weight:600}

.nav{display:none}
@media(min-width:800px){.nav{display:flex;gap:28px;align-items:center}}
.nav a{font-size:14px;color:var(--muted);font-weight:500;transition:color 160ms}
.nav a:hover{color:var(--white)}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:12px 24px;border-radius:999px;border:none;cursor:pointer;
  font-size:14px;font-weight:700;transition:all 180ms;text-decoration:none;
  white-space:nowrap}
.btn-primary{background:linear-gradient(135deg,var(--blue),var(--cyan));
  color:var(--navy);box-shadow:0 8px 28px rgba(0,180,255,.3)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(0,180,255,.5)}
.btn-primary:disabled{opacity:.5;cursor:not-allowed;transform:none}
.btn-ghost{background:transparent;color:var(--white);border:1px solid var(--border)}
.btn-ghost:hover{border-color:var(--blue)}
.btn-block{width:100%}

.hero{padding:56px 0 72px;position:relative;z-index:2}
.hero-grid{display:grid;grid-template-columns:1fr;gap:48px;align-items:center}
@media(min-width:900px){.hero-grid{grid-template-columns:1.1fr .9fr;gap:64px}}

.eyebrow{display:inline-flex;align-items:center;gap:10px;
  padding:7px 16px;border-radius:999px;
  background:rgba(0,180,255,.1);border:1px solid var(--border);
  font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;
  color:var(--blue);width:fit-content;margin-bottom:24px}
.eyebrow-dot{width:6px;height:6px;border-radius:50%;
  background:var(--blue);box-shadow:0 0 12px var(--cyan);
  animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

.hero h1{font-size:clamp(34px,7vw,58px);font-weight:900;letter-spacing:-.035em;margin-bottom:20px}
.hero h1 .line{display:block}
.hero h1 .acc{background:linear-gradient(135deg,var(--blue),var(--cyan));
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent}
.hero-lede{font-size:17px;line-height:1.65;color:var(--muted);max-width:560px;margin-bottom:28px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.hero-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;
  margin-top:40px;padding-top:28px;border-top:1px solid var(--border-soft)}
.trust-item strong{display:block;font-size:22px;font-weight:800;
  color:var(--blue);letter-spacing:-.02em}
.trust-item span{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}

.hero-visual{position:relative;min-height:400px;display:flex;
  align-items:center;justify-content:center}
.hero-visual svg{width:100%;max-width:460px;height:auto;
  filter:drop-shadow(0 0 30px rgba(0,180,255,.4))}

section{padding:80px 0;position:relative;z-index:2}
@media(max-width:600px){section{padding:56px 0}}

.sec-head{max-width:640px;margin:0 auto 56px;text-align:center}
.sec-eyebrow{display:inline-block;font-size:11px;font-weight:700;
  letter-spacing:.22em;text-transform:uppercase;color:var(--blue);margin-bottom:14px}
.sec-title{font-size:clamp(26px,4vw,38px);margin-bottom:16px}
.sec-lede{font-size:16px;color:var(--muted);line-height:1.65}

.steps-grid{display:grid;grid-template-columns:1fr;gap:20px}
@media(min-width:700px){.steps-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1000px){.steps-grid{grid-template-columns:repeat(4,1fr)}}
.step{padding:28px 24px;border-radius:14px;
  background:linear-gradient(180deg,rgba(10,31,68,.55),rgba(5,21,48,.75));
  border:1px solid var(--border-soft)}
.step-num{display:inline-block;padding:4px 12px;border-radius:999px;
  background:rgba(0,180,255,.08);border:1px solid var(--border);
  font-family:ui-monospace,monospace;font-size:11px;font-weight:700;
  color:var(--blue);letter-spacing:.08em;margin-bottom:16px}
.step h3{font-size:16px;margin-bottom:8px}
.step p{font-size:13px;color:var(--muted);line-height:1.55}

.why-grid{display:grid;grid-template-columns:1fr;gap:16px}
@media(min-width:700px){.why-grid{grid-template-columns:repeat(3,1fr)}}
.why-card{padding:24px;border-radius:12px;
  background:rgba(10,31,68,.4);border:1px solid var(--border-soft)}
.why-card h3{font-size:15px;margin-bottom:8px}
.why-card p{font-size:13px;color:var(--muted);line-height:1.55}
.why-icon{width:36px;height:36px;border-radius:8px;
  background:rgba(0,180,255,.12);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  color:var(--blue);margin-bottom:16px}
.why-icon svg{width:18px;height:18px}

.request-section{padding:72px 0;
  background:linear-gradient(180deg,transparent,rgba(0,180,255,.03))}
.request-card{max-width:600px;margin:0 auto;padding:40px 32px;border-radius:20px;
  background:linear-gradient(135deg,rgba(15,42,92,.85),rgba(0,11,31,.95));
  border:1px solid var(--border);
  box-shadow:0 20px 60px rgba(0,180,255,.15)}
@media(max-width:600px){.request-card{padding:28px 22px}}
.request-card h2{font-size:26px;margin-bottom:8px;text-align:center}
.request-card > p{font-size:14px;color:var(--muted);text-align:center;margin-bottom:28px}

.field{margin-bottom:16px}
.field label{display:block;font-size:13px;font-weight:500;color:var(--muted);margin-bottom:6px}
.field label .opt{color:var(--subtle);font-weight:400;font-size:12px}
.input,.select,.textarea{width:100%;padding:12px 16px;border-radius:10px;
  background:rgba(0,11,31,.6);border:1px solid var(--border);
  color:var(--white);font-size:15px;transition:all 180ms}
.input::placeholder,.textarea::placeholder{color:var(--dim)}
.input:focus,.select:focus,.textarea:focus{outline:none;
  border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,180,255,.15)}
.textarea{resize:vertical;min-height:100px;font-family:var(--font)}
.row2{display:grid;grid-template-columns:1fr;gap:14px}
@media(min-width:600px){.row2{grid-template-columns:1fr 1fr}}
.err{font-size:12px;color:var(--danger);min-height:14px;margin-top:4px}

.banner{padding:12px 16px;border-radius:10px;font-size:13px;
  margin-bottom:18px;display:none;line-height:1.55}
.banner.show{display:block}
.banner-err{background:rgba(248,113,113,.12);color:#fca5a5;border:1px solid rgba(248,113,113,.3)}

.submit-note{font-size:12px;color:var(--subtle);text-align:center;margin-top:16px}

.success-screen{position:fixed;inset:0;z-index:500;
  background:rgba(0,11,31,.95);backdrop-filter:blur(20px);
  display:flex;align-items:center;justify-content:center;padding:20px}
.success-card{max-width:480px;width:100%;padding:44px 32px;border-radius:20px;
  background:linear-gradient(180deg,rgba(15,42,92,.9),rgba(0,11,31,.98));
  border:1px solid var(--border);text-align:center}
.success-icon{width:72px;height:72px;margin:0 auto 24px;border-radius:50%;
  background:linear-gradient(135deg,var(--blue),var(--cyan));
  display:flex;align-items:center;justify-content:center;
  font-size:32px;color:var(--navy);font-weight:800;
  box-shadow:0 0 40px rgba(0,180,255,.5)}
.success-card h2{font-size:22px;margin-bottom:12px}
.success-card p{font-size:14px;color:var(--muted);line-height:1.65;margin-bottom:24px}
.success-card .email-highlight{color:var(--blue);font-weight:600}

footer{padding:56px 0 40px;border-top:1px solid var(--border-soft);position:relative;z-index:2}
.footer-grid{display:grid;grid-template-columns:1fr;gap:32px;margin-bottom:40px}
@media(min-width:700px){.footer-grid{grid-template-columns:2fr 1fr 1fr}}
.footer-brand{display:flex;flex-direction:column;gap:16px}
.footer-brand-name{display:flex;align-items:baseline;gap:2px;font-size:22px;font-weight:800}
.footer-brand-name .plus{color:var(--blue);font-weight:900}
.footer-brand p{font-size:13px;color:var(--muted);line-height:1.6;max-width:340px}
.footer-slogan{font-size:11px;color:var(--subtle);text-transform:uppercase;letter-spacing:.16em;margin-top:8px}
.footer-nav h4{font-size:11px;font-weight:700;letter-spacing:.16em;
  text-transform:uppercase;color:var(--subtle);margin:0 0 14px}
.footer-nav ul{display:flex;flex-direction:column;gap:10px}
.footer-nav a{font-size:13px;color:var(--muted);transition:color 160ms}
.footer-nav a:hover{color:var(--blue)}
.footer-bottom{padding-top:28px;border-top:1px solid var(--border-soft);
  font-size:12px;color:var(--subtle);line-height:1.7}
.footer-bottom strong{color:var(--muted);display:block;margin-bottom:8px}

.toasts{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);
  z-index:600;display:flex;flex-direction:column;gap:8px;
  pointer-events:none;max-width:calc(100vw - 40px)}
.toast{padding:12px 20px;background:var(--navy2);
  border:1px solid var(--border);border-left:3px solid var(--blue);
  border-radius:10px;color:var(--white);font-size:13px;
  box-shadow:0 8px 30px rgba(0,180,255,.25);
  pointer-events:auto;min-width:240px;animation:tin 260ms}
.toast-err{border-left-color:var(--danger)}
.toast-ok{border-left-color:var(--success)}
@keyframes tin{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

.spinner{display:inline-block;width:14px;height:14px;
  border:2px solid currentColor;border-top-color:transparent;
  border-radius:50%;animation:spin 700ms linear infinite;
  vertical-align:-2px;margin-right:6px}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>

<header>
  <div class="wrap hrow">
    <a href="#" class="logo">
      <svg viewBox="0 0 64 64">
        <defs><linearGradient id="lg" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#0096FF"/>
          <stop offset="100%" stop-color="#00D4FF"/>
        </linearGradient></defs>
        <path d="M10 8 H34 C48 8 58 18 58 32 C58 46 48 56 34 56 H10 Z"
              fill="none" stroke="url(#lg)" stroke-width="6" stroke-linejoin="round"/>
        <path d="M8 32 L18 32 L23 22 L28 42 L33 28 L38 32 L46 32"
              fill="none" stroke="url(#lg)" stroke-width="3.5"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="lname">
        <span class="ltitle">Digital<span class="plus">+</span></span>
        <span class="ltag">Discover Talent. <span class="acc">Build Tomorrow.</span></span>
      </span>
    </a>
    <a href="#request" class="btn btn-primary">Request access</a>
  </div>
</header>

<main>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">
          <span class="eyebrow-dot"></span>
          The future of work in Africa
        </span>
        <h1>
          <span class="line">Hire great</span>
          <span class="line acc">talent in Kenya.</span>
        </h1>
        <p class="hero-lede">
          Digital+ connects verified employers with Africa's best talent.
          Success-based pricing. Full audit trail. No cost to candidates.
        </p>
        <div class="hero-actions">
          <a href="#request" class="btn btn-primary">Request access</a>
          <a href="#how" class="btn btn-ghost">See how it works</a>
        </div>
        <div class="hero-trust">
          <div class="trust-item"><strong>40K+</strong><span>Verified talent</span></div>
          <div class="trust-item"><strong>92%</strong><span>Match accuracy</span></div>
          <div class="trust-item"><strong>14 days</strong><span>Avg. time to hire</span></div>
        </div>
      </div>
      <div class="hero-visual">
        <svg viewBox="0 0 400 400">
          <defs>
            <linearGradient id="mapGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#00B4FF" stop-opacity=".9"/>
              <stop offset="100%" stop-color="#22D3EE" stop-opacity=".9"/>
            </linearGradient>
            <radialGradient id="nodeGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#00D4FF" stop-opacity="1"/>
              <stop offset="100%" stop-color="#0096FF" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <path d="M140 40 C160 30,185 32,205 45 C225 58,245 65,265 75
                   C283 84,300 96,308 115 C314 130,312 145,306 158
                   C300 170,296 182,298 195 C300 210,310 220,320 234
                   C330 250,334 266,328 280 C322 296,308 306,295 314
                   C280 322,268 334,262 350 C256 366,252 382,242 395
                   C230 408,214 412,200 408 C186 404,175 392,168 378
                   C160 362,158 346,150 332 C142 318,130 308,116 300
                   C102 292,88 280,82 264 C76 248,78 232,88 220
                   C98 208,94 194,86 180 C78 166,74 152,78 136
                   C82 122,92 112,102 100 C112 88,124 74,136 60
                   C138 55,138 45,140 40 Z"
                fill="url(#mapGrad)" fill-opacity=".12"
                stroke="url(#mapGrad)" stroke-width="2.5" stroke-linejoin="round"/>
          <g fill="url(#nodeGlow)">
            <circle cx="200" cy="115" r="16"/>
            <circle cx="155" cy="215" r="16"/>
            <circle cx="230" cy="180" r="16"/>
            <circle cx="195" cy="255" r="16"/>
            <circle cx="260" cy="290" r="16"/>
          </g>
          <g fill="#00D4FF">
            <circle cx="200" cy="115" r="5"/>
            <circle cx="155" cy="215" r="5"/>
            <circle cx="230" cy="180" r="5"/>
            <circle cx="195" cy="255" r="5"/>
            <circle cx="260" cy="290" r="5"/>
          </g>
          <g stroke="#00D4FF" stroke-width="1" stroke-opacity=".35" fill="none">
            <line x1="200" y1="115" x2="155" y2="215"/>
            <line x1="200" y1="115" x2="230" y2="180"/>
            <line x1="155" y1="215" x2="195" y2="255"/>
            <line x1="230" y1="180" x2="195" y2="255"/>
            <line x1="195" y1="255" x2="260" y2="290"/>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-eyebrow">How it works</span>
        <h2 class="sec-title">Four steps from request to hire</h2>
        <p class="sec-lede">
          We verify every employer. Then we match you with candidates who
          actually fit. You only pay when a hire is confirmed.
        </p>
      </div>
      <div class="steps-grid">
        <div class="step"><span class="step-num">01</span><h3>Request access</h3><p>Submit your details. We review within 2 business days.</p></div>
        <div class="step"><span class="step-num">02</span><h3>Get verified</h3><p>Submit KRA PIN and business registration. Auto-verified in minutes.</p></div>
        <div class="step"><span class="step-num">03</span><h3>Post &amp; match</h3><p>Publish roles. Get ranked applicants with match scores.</p></div>
        <div class="step"><span class="step-num">04</span><h3>Hire &amp; pay</h3><p>Confirm the hire. Success fee invoiced after.</p></div>
      </div>
    </div>
  </section>

  <section id="why">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-eyebrow">Why Digital+</span>
        <h2 class="sec-title">Built for employers who value their time</h2>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </div>
          <h3>Verified employers only</h3>
          <p>KRA PIN and business registration checked automatically. Fake accounts don't get through.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/>
            </svg>
          </div>
          <h3>Transparent matching</h3>
          <p>See exactly why a candidate scored what they did. No black boxes.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <h3>Success-based pricing</h3>
          <p>No retainer. No seat fees. You pay only after a hire is confirmed.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="request" class="request-section">
    <div class="wrap">
      <div class="request-card">
        <h2>Request access to Digital+</h2>
        <p>Tell us about your company. We'll review and send you a link to get started.</p>

        <div class="banner banner-err" id="form-error"></div>

        <form id="request-form" novalidate>
          <div class="row2">
            <div class="field">
              <label for="r-company">Company name</label>
              <input id="r-company" class="input" type="text" required placeholder="Acme Ltd" />
              <div class="err" id="e-company"></div>
            </div>
            <div class="field">
              <label for="r-name">Your name</label>
              <input id="r-name" class="input" type="text" required placeholder="Jane Doe" />
              <div class="err" id="e-name"></div>
            </div>
          </div>

          <div class="row2">
            <div class="field">
              <label for="r-email">Work email</label>
              <input id="r-email" class="input" type="email" required placeholder="you@company.co.ke" />
              <div class="err" id="e-email"></div>
            </div>
            <div class="field">
              <label for="r-phone">Phone <span class="opt">(optional)</span></label>
              <input id="r-phone" class="input" type="tel" placeholder="0712 345 678" />
            </div>
          </div>

          <div class="row2">
            <div class="field">
              <label for="r-industry">Industry</label>
              <select id="r-industry" class="select" required>
                <option value="">Select</option>
                <option>Technology</option>
                <option>Finance &amp; fintech</option>
                <option>Logistics</option>
                <option>Retail</option>
                <option>Healthcare</option>
                <option>Education</option>
                <option>Manufacturing</option>
                <option>Professional services</option>
                <option>Other</option>
              </select>
              <div class="err" id="e-industry"></div>
            </div>
            <div class="field">
              <label for="r-size">Team size</label>
              <select id="r-size" class="select" required>
                <option value="">Select</option>
                <option>1–10</option>
                <option>11–50</option>
                <option>51–200</option>
                <option>201–500</option>
                <option>500+</option>
              </select>
              <div class="err" id="e-size"></div>
            </div>
          </div>

          <div class="field">
            <label for="r-needs">What roles are you hiring for? <span class="opt">(optional)</span></label>
            <textarea id="r-needs" class="textarea" placeholder="e.g. Senior engineers, sales leads, designers."></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block" id="submit-btn">
            Send request
          </button>
          <p class="submit-note">No cost to submit. We review every request within 2 business days.</p>
        </form>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <div class="footer-grid">
