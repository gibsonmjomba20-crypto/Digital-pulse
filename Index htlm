<div class="toasts" role="status" aria-live="polite"></div>

<script>
const SUPA_URL = "https://romtpcesomndihfwgmpw.supabase.co";
const SUPA_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJvbXRwY2Vzb21uZGloZndnbXB3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE1NTgzMzIsImV4cCI6MjEwNzEzNDMzMn0.s4jJTb5Staw07wraudMwEsukQ5Ryj4hMugm_9lSxxA8";
const EMAILJS_SERVICE  = "service_zs9ztak";
const EMAILJS_TEMPLATE = "template_77xb6gk";
const EMAILJS_KEY      = "tcFhpPs9jeUwD9Lbj";
const NTIFY_URL        = "https://ntfy.sh/digitalplus-gibson-alerts";

function toast(msg, kind){
  const r = document.querySelector('.toasts');
  const el = document.createElement('div');
  el.className = 'toast toast-' + (kind || 'ok');
  el.textContent = msg;
  r.appendChild(el);
  setTimeout(() => el.remove(), 5000);
}

function showBanner(msg){
  const b = document.getElementById('form-error');
  b.textContent = msg;
  b.classList.add('show');
}
function hideBanner(){
  document.getElementById('form-error').classList.remove('show');
}

document.getElementById('request-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  hideBanner();

  const btn = document.getElementById('submit-btn');
  const email = document.getElementById('r-email').value.trim();
  const company = document.getElementById('r-company').value.trim();
  const name = document.getElementById('r-name').value.trim();
  const phone = document.getElementById('r-phone').value.trim();
  const industry = document.getElementById('r-industry').value;
  const size = document.getElementById('r-size').value;
  const needs = document.getElementById('r-needs').value.trim();

  let ok = true;
  if (!company){ document.getElementById('e-company').textContent = 'Required.'; ok = false; }
  else document.getElementById('e-company').textContent = '';
  if (!name){ document.getElementById('e-name').textContent = 'Required.'; ok = false; }
  else document.getElementById('e-name').textContent = '';
  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
    document.getElementById('e-email').textContent = 'Enter a valid email.'; ok = false;
  } else document.getElementById('e-email').textContent = '';
  if (!industry){ document.getElementById('e-industry').textContent = 'Required.'; ok = false; }
  else document.getElementById('e-industry').textContent = '';
  if (!size){ document.getElementById('e-size').textContent = 'Required.'; ok = false; }
  else document.getElementById('e-size').textContent = '';

  if (!ok) return;

  btn.disabled = true;
  const orig = btn.textContent;
  btn.innerHTML = '<span class="spinner"></span> Sending…';

  try {
    // Save to Supabase
    const res = await fetch(SUPA_URL + '/rest/v1/employer_requests', {
      method: 'POST',
      headers: {
        'apikey': SUPA_KEY,
        'Authorization': 'Bearer ' + SUPA_KEY,
        'Content-Type': 'application/json',
        'Prefer': 'return=minimal'
      },
      body: JSON.stringify({
        email, company_name: company, contact_name: name,
        phone: phone || null, industry, team_size: size,
        hiring_needs: needs || null, status: 'PENDING'
      })
    });
    if (!res.ok) throw new Error('Could not save request. Try again.');

    // Confirmation email
    try {
      await fetch("https://api.emailjs.com/api/v1.0/email/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          service_id: EMAILJS_SERVICE,
          template_id: EMAILJS_TEMPLATE,
          user_id: EMAILJS_KEY,
          template_params: {
            to_email: email,
            from_company: 'Digital+',
            reply_to: 'gibsonmjomba20@gmail.com',
            subject: 'We received your Digital+ access request',
            message: 'Hi ' + (name || 'there') + ',\n\nThank you for your interest in Digital+.\n\nWe received your request for ' + company + '. Our team will review it within 2 business days.\n\nWarm regards,\nDigitalPulse Team'
          }
        })
      });
    } catch (e) { console.warn('email failed', e); }

    // Phone buzz
    try {
      await fetch(NTIFY_URL, {
        method: "POST",
        headers: { "Title": "New Digital+ request", "Priority": "high" },
        body: company + " — " + email
      });
    } catch (e) {}

    document.getElementById('success-email').textContent = email;
    document.getElementById('success-screen').classList.remove('hidden');
    document.getElementById('request-form').reset();
  } catch (err){
    showBanner(err.message || 'Something went wrong.');
    toast('Request failed', 'err');
  } finally {
    btn.disabled = false;
    btn.textContent = orig;
  }
});

window.closeSuccess = function(){
  document.getElementById('success-screen').classList.add('hidden');
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

document.getElementById('yr').textContent = new Date().getFullYear();
</script>

</body>
</html>
